PORT=3000

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=blueteam_eventos
DB_USER=postgres
DB_PASSWORD=cambiar_esta_clave

# Sesión (los usa la rama auth-sesion-auditoria)
SESSION_SECRET=cambiar_por_un_texto_largo_y_aleatorio
SESSION_TIMEOUT_SECONDS=60

# true solo cuando el sistema se publique con HTTPS
COOKIE_SECURE=false
