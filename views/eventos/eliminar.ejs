<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Eliminar Evento</title>
    <link rel="stylesheet" href="/css/eventos-compras.css" />
  </head>
  <body class="ev">
    <header class="barra">
      <span class="marca">Entradas</span>
      <nav><a href="/">Inicio</a><a href="/eventos">Eventos</a></nav>
    </header>

    <main class="contenedor angosto">
      <h1>Eliminar Evento</h1>

      <div class="tarjeta">
        <% if (error) { %>
          <p class="alerta error"><%= error %></p>
        <% } %>

        <p>¿Seguro que quieres eliminar el evento <strong><%= evento.nombre %></strong>?</p>

        <form method="POST" action="/eventos/<%= evento.id %>/eliminar">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="acciones">
            <button class="peligro" type="submit">Sí, eliminar</button>
            <a class="boton secundario" href="/eventos/<%= evento.id %>">Cancelar</a>
          </div>
        </form>
      </div>
    </main>
  </body>
</html>
