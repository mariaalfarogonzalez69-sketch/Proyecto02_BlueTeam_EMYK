<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= titulo %></title>
    <link rel="stylesheet" href="/css/eventos-compras.css">
    <link rel="stylesheet" href="/css/sesion.css">
    <link rel="stylesheet" href="/css/usuarios-roles.css">
</head>
<body class="ev">
    <header class="barra">
        <span class="marca">Entradas</span>
        <nav aria-label="Navegación principal">
            <a href="/">Inicio</a>
            <a href="/eventos">Eventos</a>
            <a href="/usuarios">Usuarios</a>
            <% if (usuario && usuario.rol === 'SuperAdmin') { %>
                <a href="/roles" class="activo">Roles</a>
            <% } %>
            <% if (usuario && usuario.permisos && usuario.permisos.includes('ver_reportes')) { %>
                <a href="/reportes/ventas">Reporte de ventas</a>
            <% } %>
            <% if (usuario && usuario.rol === 'Taquillero') { %>
                <a href="/puerta">Validar entrada</a>
            <% } %>
            <% if (usuario && usuario.rol === 'SuperAdmin') { %>
                <a href="/auditoria">Auditoría</a>
            <% } %>
            <form class="salir" method="POST" action="/logout">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit">Cerrar sesión</button>
            </form>
        </nav>
    </header>

    <main class="admin-contenedor">
        <div class="admin-encabezado">
            <div>
                <h1><%= titulo %></h1>
                <p class="admin-descripcion">Modifique el nombre y los permisos asignados al rol.</p>
            </div>
        </div>

        <section class="tarjeta admin-tarjeta">
            <% if (error) { %>
                <p class="admin-error" role="alert"><%= error %></p>
            <% } %>

            <form class="admin-formulario" action="/roles/<%= rol.id %>/editar" method="POST">
                <input type="hidden" name="_csrf"
                    value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

                <div>
                    <label for="nombre">Nombre del rol</label>
                    <input id="nombre" name="nombre" maxlength="50"
                        value="<%= rol.nombre %>" required
                        <%= rol.nombre === 'SuperAdmin' ? 'readonly' : '' %>>
                </div>

                <fieldset>
                    <legend>Permisos del rol</legend>
                    <% const asignados = rol.Permisos.map(p => p.nombre); %>

                    <% if (rol.nombre === 'SuperAdmin') { %>
                        <p class="admin-descripcion">
                            Los permisos del rol SuperAdmin están protegidos y no se pueden modificar.
                        </p>
                    <% } else { %>
                        <p class="admin-descripcion">Seleccione los permisos que tendrá este rol.</p>
                    <% } %>

                    <div class="admin-permisos">
                        <% permisos.forEach(permiso => { %>
                            <label>
                                <input type="checkbox" name="permisos"
                                    value="<%= permiso.nombre %>"
                                    <%= asignados.includes(permiso.nombre) ? 'checked' : '' %>
                                    <%= rol.nombre === 'SuperAdmin' ? 'disabled' : '' %>>
                                <%= permiso.nombre %>
                            </label>

                            <% if (rol.nombre === 'SuperAdmin' && asignados.includes(permiso.nombre)) { %>
                                <input type="hidden" name="permisos"
                                    value="<%= permiso.nombre %>">
                            <% } %>
                        <% }) %>
                    </div>
                </fieldset>

                <div class="admin-acciones">
                    <button class="boton" type="submit">Guardar cambios</button>
                    <a class="admin-enlace" href="/roles">Cancelar</a>
                </div>
            </form>
        </section>
    </main>
</body>
</html>
