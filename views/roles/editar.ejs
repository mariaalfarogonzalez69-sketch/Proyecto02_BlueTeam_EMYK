
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title><%= titulo %></title>
</head>
<body>
    <h1><%= titulo %></h1>

    <p><a href="/roles">Volver a roles</a></p>

    <% if (error) { %>
        <p role="alert"><%= error %></p>
    <% } %>

    <form action="/roles/<%= rol.id %>/editar" method="POST">
        <input
            type="hidden"
            name="_csrf"
            value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>"
        >

        <label for="nombre">Nombre del rol:</label>

        <input
            id="nombre"
            name="nombre"
            maxlength="50"
            value="<%= rol.nombre %>"
            required
            <%= rol.nombre === 'SuperAdmin' ? 'readonly' : '' %>
        >

        <fieldset>
            <legend>Permisos del rol</legend>

            <% const asignados = rol.Permisos.map(p => p.nombre); %>

            <% permisos.forEach(permiso => { %>
                <label>
                    <input
                        type="checkbox"
                        name="permisos"
                        value="<%= permiso.nombre %>"
                        <%= asignados.includes(permiso.nombre) ? 'checked' : '' %>
                        <%= rol.nombre === 'SuperAdmin' ? 'disabled' : '' %>
                    >

                    <%= permiso.nombre %>
                </label>

                <% if (rol.nombre === 'SuperAdmin' && asignados.includes(permiso.nombre)) { %>
                    <input
                        type="hidden"
                        name="permisos"
                        value="<%= permiso.nombre %>"
                    >
                <% } %>

                <br>
            <% }) %>
        </fieldset>

        <button type="submit">Guardar cambios</button>
    </form>
</body>
</html>
