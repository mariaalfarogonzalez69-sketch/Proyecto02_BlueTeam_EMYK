
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= titulo %></title>

    <link rel="stylesheet" href="/css/eventos-compras.css">
    <link rel="stylesheet" href="/css/sesion.css">
    <link rel="stylesheet" href="/css/usuarios-roles.css">
</head>
<body class="ev">
    <header class="barra">
        <span class="marca">Entradas</span>

        <nav aria-label="Navegación principal">
            <a href="/">Inicio</a>
            <a href="/eventos">Eventos</a>
            <a href="/usuarios">Usuarios</a>

            <% if (usuario && usuario.rol === 'SuperAdmin') { %>
                <a href="/roles" class="activo">Roles</a>
            <% } %>

            <% if (usuario && usuario.permisos && usuario.permisos.includes('ver_reportes')) { %>
                <a href="/reportes/ventas">Reporte de ventas</a>
            <% } %>

            <% if (usuario && usuario.rol === 'Taquillero') { %>
                <a href="/puerta">Validar entrada</a>
            <% } %>

            <% if (usuario && usuario.rol === 'SuperAdmin') { %>
                <a href="/auditoria">Auditoría</a>
            <% } %>

            <form class="salir" method="POST" action="/logout">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit">Cerrar sesión</button>
            </form>
        </nav>
    </header>

    <main class="admin-contenedor">
        <div class="admin-encabezado">
            <div>
                <h1><%= titulo %></h1>
                <p class="admin-descripcion">
                    Administre los roles y los permisos asignados a cada uno.
                </p>
            </div>

            <a class="boton" href="/roles/nuevo">Crear rol</a>
        </div>

        <% if (mensaje === 'creado') { %>
            <p class="admin-mensaje" role="status">
                Rol creado correctamente.
            </p>
        <% } else if (mensaje === 'actualizado') { %>
            <p class="admin-mensaje" role="status">
                Rol actualizado correctamente.
            </p>
        <% } else if (mensaje === 'eliminado') { %>
            <p class="admin-mensaje" role="status">
                Rol eliminado correctamente.
            </p>
        <% } %>

        <section class="tarjeta">
            <div class="admin-tabla">
                <table>
                    <thead>
                        <tr>
                            <th>Rol</th>
                            <th>Permisos</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        <% if (roles.length === 0) { %>
                            <tr>
                                <td colspan="3" class="vacio">
                                    No hay roles registrados.
                                </td>
                            </tr>
                        <% } else { %>
                            <% roles.forEach(rol => { %>
                                <tr>

                                    <td>
                                        <strong><%= rol.nombre %></strong>
                                    </td>

                                    <td class="permisos">
                                        <%= rol.Permisos.length
                                            ? rol.Permisos.map(p => p.nombre).join(', ')
                                            : 'Sin permisos' %>
                                    </td>

                                    <td>
                                        <div class="admin-acciones">
                                            <a
                                                class="admin-enlace"
                                                href="/roles/<%= rol.id %>/editar"
                                            >
                                                Editar
                                            </a>

                                            <% if (!['SuperAdmin', 'Auditor', 'Taquillero'].includes(rol.nombre)) { %>
                                                <form
                                                    action="/roles/<%= rol.id %>/eliminar"
                                                    method="POST"
                                                    data-confirm="¿Eliminar este rol?"
                                                >
                                                    <input
                                                        type="hidden"
                                                        name="_csrf"
                                                        value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>"
                                                    >

                                                    <button
                                                        class="boton peligro"
                                                        type="submit"
                                                    >
                                                        Eliminar
                                                    </button>
                                                </form>
                                            <% } %>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </section>
    </main>

    <script src="/js/confirmar.js"></script>
</body>
</html>
